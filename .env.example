# ── LLM Backend (pick one) ────────────────────────────────────────────────────
#
# Option A: OpenAI (cloud)
#   Set OPENAI_API_KEY. Ollama is ignored when this is present.
OPENAI_API_KEY=sk-...

# Option B: Ollama (local, free)
#   Leave OPENAI_API_KEY unset (or remove it).
#   Install Ollama: https://ollama.com  →  `ollama pull llama3.2`
#   ChatPLVis will auto-detect a running Ollama instance at OLLAMA_BASE_URL.
#   OLLAMA_BASE_URL=http://localhost:11434
#   OLLAMA_MODEL=llama3.2

# ── Data paths ─────────────────────────────────────────────────────────────────
CSV_PATH=uploads/mycobacterium_proteome_df.csv
COUNTS_PATH=data/counts_all_stages_MAGECK_with_ES.xlsx

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false
